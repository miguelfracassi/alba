{
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" },
    { "source": "/perfil/:username", "destination": "/perfil.html" },
    { "source": "/mensagens/:username", "destination": "/mensagens.html" },
    { "source": "/post/:id", "destination": "/post.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
    { "source": "/(.*)\\.(png|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
